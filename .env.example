# =============================================================================
# SAAS SKI VESOTEL - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# =============================================================================
# Copie este archivo a .env antes de iniciar la aplicacion: cp .env.example .env
# =============================================================================

# --- ENTORNO ---
ENVIRONMENT=development
NODE_ENV=development

# --- ORQUESTACION MULTI-ENTORNO (OPCIONAL PARA WORKTREES / AGENTES) ---
# Nombre unico del proyecto docker compose (por defecto: ski_dev en local, ski_prod en produccion)
COMPOSE_PROJECT_NAME=ski_dev
# Puerto expuesto en el host para el Gateway Nginx (desarrollo)
GATEWAY_PORT=8080

# --- BYPASS DE LOGIN EN DESARROLLO ---
DEV_LOGIN_BYPASS=true
DEV_ADMIN_EMAIL=admin@vesotel.com
DEV_ADMIN_PASSWORD=
DEV_ADMIN_COMPANY=Vesotel Ski School
DEV_ADMIN_FIRST_NAME=Admin
DEV_ADMIN_LAST_NAME=Vesotel
NEXT_PUBLIC_DEV_LOGIN_BYPASS=true

# --- PERSISTENCIA: POSTGRESQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# --- SEMBRADO DE USUARIO INICIAL (DESARROLLO / BOOTSTRAP) ---
INITIAL_ADMIN_EMAIL=admin@vesotel.com
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAME=Vesotel
INITIAL_COMPANY_NAME="Vesotel Ski School"

# --- CACHE Y SESIONES: REDIS ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# --- SEGURIDAD Y CRIPTOGRAFIA ---
# Clave simetrica Fernet para cifrado de secretos TOTP/2FA en base de datos (opcional en dev, se auto-genera si esta vacia).
# Generar con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Clave secreta para JWT (RS256 requiere par de claves en keys/ o variables)
# Generar con: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=
JWT_PRIVATE_KEY_PASSPHRASE=

# Parametros de expiracion de tokens
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
TOTP_ISSUER_NAME=Vesotel Ski

# --- RED Y CORS ---
# Origenes permitidos separados por comas para el middleware CORS
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# --- FRONTEND (NEXT.JS) ---
PORT=3000
HOSTNAME=0.0.0.0
# En desarrollo bajo Gateway Nginx utilizar /api
NEXT_PUBLIC_API_URL=/api
# URL interna si se ejecuta Next.js directamente en el host
BACKEND_INTERNAL_URL=http://localhost:8000

# --- NOTIFICACIONES Y CORREO (SMTP) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=notificaciones@vesotel.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME="Vesotel Notificaciones"
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=False

# --- COPIAS DE SEGURIDAD (SOLO PRODUCCION) ---
# BACKUP_DIR=/mnt/nas_backups/clases-vesotel